# SP Portal Backend — contoh environment. Salin ke .env lalu sesuaikan.
# (dotenv membaca file .env secara otomatis saat server start.)

# Lingkungan: "development" (default) atau "production". Saat "production",
# server MENOLAK start bila SECRET_KEY masih default/kurang dari 32 karakter
# atau BOOTSTRAP_ADMIN_PASSWORD masih "admin123".
NODE_ENV=development

# Database. Default SQLite (1 file, zero-config).
# Catatan: Prisma memakai bentuk URL "file:" (bukan "sqlite:///").
DATABASE_URL=file:./sp_portal.db

# Kunci penandatangan JWT — WAJIB diganti string acak panjang (>=32 char) di produksi.
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Masa berlaku token akses (menit). 1440 = 24 jam.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origin frontend yang diizinkan (CORS), dipisah koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Akun super admin awal yang dibuat otomatis bila DB kosong (untuk testing).
BOOTSTRAP_ADMIN_EMAIL=admin@spportal.id
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Panitia Inti

# WhatsApp & Email blasting BELUM diimplementasikan. Notifikasi hanya dicatat
# (log-only). Biarkan false sampai gateway WA/email disiapkan.
NOTIFICATIONS_ENABLED=false

# Port HTTP server.
PORT=8000
