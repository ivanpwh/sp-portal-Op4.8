# === SP Portal — Frontend environment (contoh) ===
# Salin ke .env.local untuk override lokal (file *.local di-gitignore).

# Mode sumber data.
#   true (atau dihapus) -> PORTOFOLIO/DEMO: aplikasi memakai data contoh dari
#                          localStorage (mock). Tanpa backend, tanpa data asli.
#   false               -> REAL: memakai backend FastAPI (butuh VITE_API_URL).
VITE_DEMO_MODE=true

# URL backend FastAPI — hanya dipakai saat VITE_DEMO_MODE=false.
VITE_API_URL=http://localhost:8000
